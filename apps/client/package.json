{
  "name": "@nestra/client",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "generate:icon-fonts": "node ./scripts/generate-icon-font-data.mjs",
    "build": "node ./scripts/generate-icon-font-data.mjs --force && expo export --platform web --output-dir dist --clear",
    "dev": "pnpm run generate:icon-fonts && expo start",
    "dev:android": "pnpm run generate:icon-fonts && expo start --android",
    "dev:ios": "pnpm run generate:icon-fonts && node ./scripts/start-ios.mjs",
    "dev:web": "pnpm run generate:icon-fonts && expo start --web --port 8081",
    "typecheck": "pnpm run generate:icon-fonts && tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@nestra/contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "axios": "^1.18.1",
    "expo": "57.0.7",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.0",
    "react-native-paper": "5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestra/tsconfig": "workspace:*",
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
