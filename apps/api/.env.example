NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
# Hosted platforms may inject PORT instead of API_PORT. When API_PORT is unset,
# the API accepts PORT as the listen port.
DATABASE_URL=postgresql://nestra:nestra_dev_password@localhost:5432/nestra
# Neon (production): use the provider pooled connection string with verified TLS, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_SESSION_EXPIRES_IN=30d
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production: keep an explicit allow-list. Add the Expo web origin used for
# verification and later Tauri/web origins when those clients exist. Native
# mobile clients are not browser CORS clients.
GOOGLE_OAUTH_ENABLED=false
# Required only when GOOGLE_OAUTH_ENABLED=true. Use a 32-byte random key encoded
# with base64; never commit real Google credentials or the encryption key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URI=
GOOGLE_OAUTH_TRANSACTION_ENCRYPTION_KEY=
GOOGLE_OAUTH_WEB_RETURN_URI=
GOOGLE_OAUTH_ANDROID_RETURN_URI=
GOOGLE_OAUTH_IOS_RETURN_URI=
GOOGLE_OAUTH_DESKTOP_RETURN_URI=
