{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nestra",
  "version": "0.0.0",
  "identifier": "com.michalrozek.nestra",
  "build": {
    "beforeDevCommand": "node ./scripts/prepare-client-dev.mjs",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "node ./scripts/prepare-client-build.mjs",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nestra",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
