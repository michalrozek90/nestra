{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set for the hardened Nestra desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-auth-secret-storage",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://accounts.google.com/o/oauth2/v2/auth?**" }]
    }
  ]
}
