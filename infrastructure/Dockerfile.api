# Production image for @nestra/api. Build from the repository root:
#   docker build -f infrastructure/Dockerfile.api -t nestra-api:local .
#
# Render: set the service runtime to Docker and the Dockerfile path to
# infrastructure/Dockerfile.api. The process listens on API_PORT, or the
# platform PORT when API_PORT is unset.

FROM node:24.18.0-bookworm-slim AS base

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@11.13.1 --activate

WORKDIR /app

FROM base AS build

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/api/package.json ./apps/api/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/tsconfig ./packages/tsconfig

RUN pnpm install --frozen-lockfile --filter @nestra/api...

COPY apps/api ./apps/api
COPY packages/contracts ./packages/contracts

RUN pnpm --filter @nestra/contracts build \
  && pnpm --filter @nestra/api build

# Drop the client-only patch so the API production deploy tree can resolve.
RUN python3 - <<'PY'
from pathlib import Path

path = Path('pnpm-workspace.yaml')
lines = path.read_text(encoding='utf-8').splitlines(keepends=True)
output: list[str] = []
skip_patch_block = False

for line in lines:
    if line.startswith('patchedDependencies:'):
        skip_patch_block = True
        continue
    if skip_patch_block:
        if line.startswith(' ') or line.startswith('\t'):
            continue
        skip_patch_block = False
    output.append(line)

path.write_text(''.join(output), encoding='utf-8')
PY

RUN CI=true pnpm --filter @nestra/api deploy --prod --legacy /out

FROM node:24.18.0-bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 nestra \
  && useradd --system --uid 1001 --gid nestra nestra

WORKDIR /app

ENV NODE_ENV=production \
  API_HOST=0.0.0.0

COPY --from=build --chown=nestra:nestra /out ./

USER nestra

EXPOSE 3000

CMD ["node", "dist/main.js"]
